# ---------------------------------------------------------------------------
# CampusRide — client environment variables (Vite).
# Copy this file to `client/.env` and fill in the values from your Firebase
# project: Firebase Console → Project settings → Your apps → Web app → SDK config.
# NEVER commit the real client/.env (it is already in .gitignore).
# These Firebase "web config" values are NOT secrets in the backend sense —
# they are safe to ship in a browser bundle; Firestore Security Rules enforce
# access. Do NOT put Admin SDK service-account keys here.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Optional college configuration ---------------------------------------
# Leave VITE_COLLEGE_EMAIL_DOMAIN empty to allow ANY email at signup; college
# eligibility is then proven via the college-ID upload + admin approval.
VITE_COLLEGE_EMAIL_DOMAIN=
VITE_COLLEGE_NAME=Sambhram Institute of Technology
VITE_USN_PREFIX=1ST

# Comma-separated admin emails (admins sign in only, never self-register).
VITE_ADMIN_EMAILS=m1@sambhram.org
# Optional Google Maps browser key. Restrict it by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
